{
  "info": {
    "name": "Employee Management API",
    "description": "Beginner-friendly requests for testing the employee CRUD endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "employeeEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Patel\",\n  \"email\": \"asha-{{$guid}}@example.com\",\n  \"department\": \"Engineering\",\n  \"salary\": 65000.00\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee was created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    const employee = pm.response.json();",
              "    pm.collectionVariables.set(\"employeeId\", employee.id);",
              "    pm.collectionVariables.set(\"employeeEmail\", employee.email);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all employees",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee list was returned\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get employee by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee was found\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"employeeId\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Patel\",\n  \"email\": \"{{employeeEmail}}\",\n  \"department\": \"Operations\",\n  \"salary\": 68000.00\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee was updated\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().department).to.eql(\"Operations\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete employee",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee was deleted\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
